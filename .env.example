APP_NAME="Competitor Intelligence"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Places API (New) is used for business autocomplete, place details,
# and local competitor discovery. Leave the key empty to disable these calls.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1
GOOGLE_PLACES_CONNECT_TIMEOUT=2
GOOGLE_PLACES_TIMEOUT=6

# The synchronous analysis stays below a normal 30-second PHP request limit.
# Keep a small response reserve so session persistence and redirect handling
# are not competing with the final provider call.
ANALYSIS_REQUEST_BUDGET_SECONDS=24
ANALYSIS_RESPONSE_RESERVE_SECONDS=2
ANALYSIS_MINIMUM_PROVIDER_WINDOW_SECONDS=1.5
ANALYSIS_PROVIDER_FALLBACK_RESERVE_SECONDS=6
WEBSITE_SCAN_CONNECT_TIMEOUT=2
WEBSITE_SCAN_TIMEOUT=8

# Gemini is optional. Without a key, business classification falls back to the
# deterministic classifier and supported discovery flows continue gracefully.
AI_CLASSIFIER_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1/interactions
GEMINI_CONNECT_TIMEOUT=2
GEMINI_TIMEOUT=6
GEMINI_DISCOVERY_TIMEOUT=8
GEMINI_MAX_OUTPUT_TOKENS=900
GEMINI_DISCOVERY_MAX_OUTPUT_TOKENS=1400
GEMINI_THINKING_LEVEL=low
